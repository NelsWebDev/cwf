// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgres"
}

// Deck manager accounts. Separate from game players (User / GameUser).
model Account {
  id           String           @id @default(cuid())
  email        String           @unique
  passwordHash String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  decks        Deck[]
  sessions     AccountSession[]

  @@map("users")
}

model AccountSession {
  tokenHash String   @id
  accountId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])

  @@map("users_sessions")
}

model BlackCard {
  id         String          @id @default(cuid())
  text       String          @db.Text
  pick       Int
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  decksCards DeckBlackCard[]
  @@map("black_cards")
}

model WhiteCard {
  id         String          @id @default(cuid())
  text       String          @db.Text
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  decksCards DeckWhiteCard[]
  @@map("white_cards")
}

model Deck {
  id             String   @id @default(cuid())
  name           String   @db.Text
  description    String?  @db.Text
  importedDeckId String?
  cahOfficial    Boolean  @default(false)
  // Informational only: any account can edit or delete any non-official deck.
  createdById    String?
  createdBy      Account? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  blackCards DeckBlackCard[]
  whiteCards DeckWhiteCard[]
  @@map("decks")
}

model DeckBlackCard {
  deckId      String
  blackCardId String
  deck        Deck      @relation(fields: [deckId], references: [id], onDelete: Cascade)
  blackCard   BlackCard @relation(fields: [blackCardId], references: [id], onDelete: Cascade)

  @@id([deckId, blackCardId])
  @@map("decks_black_cards")
}

model DeckWhiteCard {
  deckId      String
  whiteCardId String
  deck        Deck      @relation(fields: [deckId], references: [id], onDelete: Cascade)
  whiteCard   WhiteCard @relation(fields: [whiteCardId], references: [id], onDelete: Cascade)

  @@id([deckId, whiteCardId])
  @@map("decks_white_cards")
}
